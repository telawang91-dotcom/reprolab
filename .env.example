DATABASE_URL=postgresql+psycopg://reprolab:reprolab@localhost:5432/reprolab
# 首次部署可填 BAAI/bge-m3 在线下载；离线部署填本地绝对路径。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PRELOAD=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 模型无关路由；未填写专用 DeepSeek key 时兼容读取上面的 LLM_API_KEY。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_API_KEY=
CLAUDE_API_KEY=
PLANNER_MODEL=deepseek:deepseek-v4-flash
EXECUTOR_MODEL=deepseek:deepseek-v4-flash
CRITIC_MODEL=deepseek:deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
SILICONFLOW_ENABLE_THINKING=false
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=reprolab-sandbox:py311
CORS_ORIGINS=http://localhost:3000
# Optional protection for the public headless Agent endpoint.
# Set this in any deployment reachable by other people.
AGENT_API_TOKEN=
AGENT_RATE_LIMIT_PER_MINUTE=30
